# --- Site ---
# Ödeme callback'i ve mutlak URL üretimi için (Vercel'de otomatik host da kullanılır)
SITE_URL=https://puki.com.tr

# --- GRC provizyon API'leri (bölge bazlı) ---
PROVISION_URL_TR=https://tr.pukisoft.com
PROVISION_URL_EU=https://eu.pukisoft.com

# GRC ile PAYLAŞILAN HMAC sırrı — GRC container'ındaki PROVISIONING_API_SECRET ile AYNI olmalı.
PROVISIONING_API_SECRET=degistir-uzun-rastgele-bir-sir

# Dahili /api/provision koruması (onay paneli çağırırken kullanılır)
INTERNAL_API_KEY=degistir-uzun-rastgele

# --- Admin onay paneli (/admin) — kullanıcı yönetimi ---
# Kurucu (sahip) hesap: bu e-posta/parola ile giriş yaparsınız. Ek ekip üyelerini
# panelden (/admin/kullanicilar) eklersiniz; onlar KV'de saklanır.
ADMIN_EMAIL=omer@complify.io
ADMIN_PASSWORD=degistir-guclu-bir-parola
ADMIN_NAME=Yönetici
# Oturum çerezini imzalamak için uzun rastgele bir sır (ör. `openssl rand -hex 32`)
AUTH_SECRET=degistir-uzun-rastgele-bir-sir

# --- Kalıcı sipariş deposu: Redis (Upstash / Vercel KV) ---
# Vercel'de "Storage → Redis (Upstash)" entegrasyonunu projeye bağlayınca
# bu değişkenler otomatik gelir. Yerelde Upstash'ten alıp doldurabilirsiniz.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# (Alternatif adlar da desteklenir: UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN)

# --- iyzico (ödeme) ---
# TEST için sandbox: https://sandbox-merchant.iyzipay.com adresinden hesap açıp anahtarları alın.
IYZICO_API_KEY=sandbox-xxxxxxxxxxxxxxxx
IYZICO_SECRET_KEY=sandbox-xxxxxxxxxxxxxxxx
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
# Canlıya geçişte:
# IYZICO_BASE_URL=https://api.iyzipay.com
