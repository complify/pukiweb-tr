# --- Site ---
# Ödeme callback'i ve mutlak URL üretimi için (Vercel'de otomatik host da kullanılır)
SITE_URL=https://puki.com.tr

# --- GRC provizyon API'leri (bölge bazlı) ---
PROVISION_URL_TR=https://tr.pukisoft.com
PROVISION_URL_EU=https://eu.pukisoft.com

# GRC ile PAYLAŞILAN HMAC sırrı — GRC container'ındaki PROVISIONING_API_SECRET ile AYNI olmalı.
PROVISIONING_API_SECRET=degistir-uzun-rastgele-bir-sir

# Dahili /api/provision koruması (onay paneli çağırırken kullanılır)
INTERNAL_API_KEY=degistir-uzun-rastgele

# --- iyzico (ödeme) ---
# TEST için sandbox: https://sandbox-merchant.iyzipay.com adresinden hesap açıp anahtarları alın.
IYZICO_API_KEY=sandbox-xxxxxxxxxxxxxxxx
IYZICO_SECRET_KEY=sandbox-xxxxxxxxxxxxxxxx
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
# Canlıya geçişte:
# IYZICO_BASE_URL=https://api.iyzipay.com
